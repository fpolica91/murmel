{
  "name": "@aweb/ui",
  "version": "0.1.0",
  "private": true,
  "description": "aweb simple-auth UI: Next.js App Router shell with Better Auth as the JWT issuer (JWKS), SSO login, and a team switcher.",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node ./scripts/migrate.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "better-auth": "^1.2.7",
    "next": "^15.3.0",
    "pg": "^8.13.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.0"
  }
}
